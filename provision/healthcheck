#! /bin/bash
set -euo pipefail

LOG_FILE="${HOME:-/home/nonroot}/healthcheck.log"
exec 1>>"${LOG_FILE}" 2>&1

HOST="${HEALTHCHECK_HOST:-localhost}"
CODE_SERVER_PORT="${CODE_SERVER_PORT:-1337}"
VERDACCIO_PORT="${VERDACCIO_PORT:-4873}"
JUPYTER_PORT="${JUPYTER_PORT:-13337}"
MARIMO_PORT="${MARIMO_PORT:-13338}"
MCP_LEAN_PORT="${MCP_LEAN_PORT:-11005}"
curl_opts=(
	--fail
	--silent
	--show-error
	--max-time 5
)
# shellcheck disable=SC2154
echo "[$(date)] Healthcheck started (image: ${IMAGE})"
status=0

check() {
	local name="$1"
	local url="$2"
	if curl "${curl_opts[@]}" "${url}" >/dev/null; then
		echo "OK: ${name} (${url})"
	else
		echo "FAIL: ${name} (${url})" >&2
		status=1
	fi
}
check_base_services() {
	check "code-server" "https://${HOST}:${CODE_SERVER_PORT}"
	check "verdaccio" "https://${HOST}:${VERDACCIO_PORT}"
	check "jupyter" "https://${HOST}:${JUPYTER_PORT}"
	check "marimo" "http://${HOST}:${MARIMO_PORT}"
}

check_gold_services() {
	check_base_services
	# mcp-lean uses Streamable HTTP on /mcp; GET returns 4xx when healthy, so probe without --fail
	if curl --silent --show-error --max-time 5 --insecure "http://${HOST}:${MCP_LEAN_PORT}/mcp" >/dev/null 2>&1; then
		echo "OK: mcp-lean (http://${HOST}:${MCP_LEAN_PORT}/mcp)"
	else
		echo "FAIL: mcp-lean (http://${HOST}:${MCP_LEAN_PORT}/mcp)" >&2
		status=1
	fi
}
case "${IMAGE}" in
notebook)
	curl_opts+=(--insecure)
	check_base_services
	;;
gold)
	curl_opts+=(--insecure)
	check_gold_services
	;;
*)
	echo "FAIL: unknown image type (${IMAGE})" >&2
	status=1
	;;
esac
echo "[$(date)] Healthcheck exiting with status ${status}"
exit "${status}"
