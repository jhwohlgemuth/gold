#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

port="${MCP_LEAN_PORT:-11005}"
host="${MCP_LEAN_HOST:-0.0.0.0}"
project_path="${LEAN_PROJECT_PATH:-${HOME}/dev}"
log_level="${LEAN_LOG_LEVEL:-INFO}"

export LEAN_PROJECT_PATH="${project_path}"
export LEAN_LOG_LEVEL="${log_level}"

if [[ ! -d "${project_path}" ]]; then
	echo "mcp-lean: LEAN_PROJECT_PATH=${project_path} does not exist; starting with empty workspace" >&2
	mkdir -p "${project_path}"
fi

exec /usr/local/bin/lean-lsp-mcp \
	--transport streamable-http \
	--host "${host}" \
	--port "${port}" >>/etc/services.d/mcp-lean/log 2>&1
