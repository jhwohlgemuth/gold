#!/usr/bin/with-contenv bash
# shellcheck shell=bash

set -eu

PORT=${JUPYTER_PORT:-13337}

if [[ -z "${JUPYTER_PASSWORD:-}" && -z "${JUPYTER_PASSWORD_HASH:-}" ]]; then
	printf '%s\n' 'jupyter: set JUPYTER_PASSWORD or JUPYTER_PASSWORD_HASH before starting the container.' >&2
	exit 1
fi

# The shipped config loads JUPYTER_CONFIG, then applies environment credentials.
# Run the base environment directly so s6 signals and logs reach Jupyter.
export TRAITLETS_APPLICATION_RAISE_CONFIG_FILE_ERROR=1
exec "${HOME}/miniconda3/bin/jupyter" lab \
	--config "${HOME}/.jupyter/jupyter_notebook_config.py" --port "${PORT}"
