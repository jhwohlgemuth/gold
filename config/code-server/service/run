#!/usr/bin/with-contenv bash
# shellcheck shell=bash

set -eu

CONFIG=${CODE_SERVER_CONFIG:-/app/code-server/config/config.yaml}
PORT=${CODE_SERVER_PORT:-1337}

if [[ -z "${CODE_SERVER_PASSWORD:-}" && -z "${CODE_SERVER_PASSWORD_HASH:-}" ]]; then
	printf '%s\n' 'code-server: set CODE_SERVER_PASSWORD or CODE_SERVER_PASSWORD_HASH before starting the container.' >&2
	exit 1
fi

# Use code-server's native environment support so secrets never enter YAML or
# command-line arguments. A supplied hash takes precedence over a password.
export PASSWORD="${CODE_SERVER_PASSWORD:-}"
export HASHED_PASSWORD="${CODE_SERVER_PASSWORD_HASH:-}"
unset CODE_SERVER_PASSWORD CODE_SERVER_PASSWORD_HASH

# Keep custom configuration read-only and require authentication even if it
# specifies auth: none. s6 captures the service's standard output and errors.
exec /app/code-server/bin/code-server --config "${CONFIG}" --auth password --port "${PORT}" "${HOME}/dev"
