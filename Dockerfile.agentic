ARG VERSION=latest
FROM ghcr.io/jhwohlgemuth/notebook:$VERSION
#
# %labels
#
LABEL author="Jason Wohlgemuth"
LABEL org.opencontainers.image.source=https://github.com/jhwohlgemuth/agentic
LABEL org.opencontainers.image.description="CUDA-enabled llama.cpp server for local LLM inference"
LABEL org.opencontainers.image.licenses=MIT
#
# %arguments
#
ARG IMAGE=agentic
ARG USER_NAME=nonroot
ARG HOME="/home/${USER_NAME}"
ARG CONTEXT_SIZE=0
ARG PORT=10732
#
# %environment
#
# LLM API endpoint (10732 = T0KEN)
EXPOSE 10732
ENV IMAGE="${IMAGE}"
ENV CC=gcc-14
ENV CXX=g++-14
ENV CUDAHOSTCXX=g++-14
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"
ENV LLAMA_ARG_CTX_SIZE="${CONTEXT_SIZE}"
ENV LLAMA_ARG_HOST=0.0.0.0
ENV LLAMA_ARG_N_PARALLEL=2
ENV LLAMA_ARG_PORT="${PORT}"
#
# %files
#
COPY --chmod=0755 --chown=${USER_NAME}:${USER_NAME} ./config/llama.cpp/service/* /etc/services.d/llama.cpp/
COPY --chmod=0755 --chown=${USER_NAME}:${USER_NAME} ./config/llama.cpp/llama-swap.yaml /llama-swap.yaml
COPY --chmod=0755 --chown=${USER_NAME}:${USER_NAME} ./provision/agentic/* /tmp/scripts/
COPY --chmod=0755 --chown=${USER_NAME}:${USER_NAME} ./provision/healthcheck /healthcheck
#
# %post
#
USER root
RUN install_cuda_toolkit
USER "${USER_NAME}"
# RUN --mount=type=secret,id=HF_API_TOKEN \
#     && mkdir -p "${MODEL_DIRECTORY}" && chmod 777 "${MODEL_DIRECTORY}" \
#     && curl -LsSf https://hf.co/cli/install.sh | bash \
#     && /tmp/scripts/build_llama_cpp_from_source.sh \
#    && hf download "${HF_REPO}" --local-dir "${MODEL_DIRECTORY}" --token "${HF_API_TOKEN}"
RUN --mount=type=secret,id=HF_API_TOKEN,env=HF_API_TOKEN \
    mkdir -p "${MODEL_DIRECTORY}" && chmod 777 "${MODEL_DIRECTORY}" \
    && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" \
    && brew tap mostlygeek/llama-swap \
    && brew install --force hf llama.cpp llama-swap
USER root
RUN cleanup
#
# %runscript
#
USER "${USER_NAME}"
WORKDIR "${HOME}/dev"
SHELL ["/bin/bash", "-c"]
HEALTHCHECK --interval=5m --timeout=30s --start-period=10s --retries=3 \
    CMD ["/bin/bash", "-c", "/healthcheck", "agentic"]
ENTRYPOINT [ "/init" ]
CMD ["/bin/zsh"]